{
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "model": "throttle-tux/claude-opus-4-6",
  "disabled_providers": [
    "opencode",
    "opencode-go"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.env.*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat */.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat */.env.*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat */.env.example",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat ~/.zshrc_secrets",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Vaults/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/agents/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.zshrc_secrets",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode/agents/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode/commands/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.agents/**",
      "effect": "allow"
    }
  ],
  "plugins": [],
  "provider": {
    "throttle-tux": {
      "npm": "@ai-sdk/anthropic",
      "name": "Tux",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "does-not-matter"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 180000,
            "output": 64000
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 180000,
            "output": 64000
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  }
}
