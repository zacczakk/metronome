{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "accent",
      "purple",
      "green",
      "orange",
      "blue"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "#161616",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#161616",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "#db6d50"
        },
        "warning": {
          "base": "#cfae7a"
        },
        "success": {
          "base": "#9aab84"
        },
        "info": {
          "base": "#8aa0b4"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#db6d50"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#4b4a48"
    },
    "scrollbar": {
      "base": "#595755"
    },
    "diff": {
      "text": {
        "added": "#9aab84",
        "removed": "#db6d50",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.neutral.300"
      },
      "background": {
        "added": "#2b2e28",
        "removed": "#36241f",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#232521",
          "removed": "#2a1f1c"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.accent.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.yellow.200",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#e4e2de",
        "200": "#d6d2cc",
        "300": "#8f8c88",
        "400": "#716f6c",
        "500": "#3f3f3d",
        "600": "#242423",
        "700": "#1e1e1d",
        "800": "#161616",
        "900": "#0d0d0d"
      },
      "red": {
        "100": "#e8886e",
        "200": "#d96a4d",
        "300": "#b95d45",
        "400": "#99503d",
        "500": "#7b4335",
        "600": "#5d372c",
        "700": "#472d26",
        "800": "#31231f",
        "900": "#241d1b"
      },
      "orange": {
        "100": "#f69d71",
        "200": "#db8458",
        "300": "#ba724e",
        "400": "#9a6144",
        "500": "#7b503a",
        "600": "#5e3f31",
        "700": "#473229",
        "800": "#312621",
        "900": "#231e1b"
      },
      "yellow": {
        "100": "#e0c493",
        "200": "#cfae7a",
        "300": "#b0956a",
        "400": "#927c5a",
        "500": "#74644b",
        "600": "#594d3c",
        "700": "#433c30",
        "800": "#2f2b25",
        "900": "#22201d"
      },
      "green": {
        "100": "#b3c39d",
        "200": "#9aab84",
        "300": "#849272",
        "400": "#6f7a60",
        "500": "#5a634f",
        "600": "#464c3f",
        "700": "#373b32",
        "800": "#282a26",
        "900": "#1f201e"
      },
      "cyan": {
        "100": "#a8c7c0",
        "200": "#8fafa8",
        "300": "#7b9590",
        "400": "#687c78",
        "500": "#556461",
        "600": "#434d4b",
        "700": "#353c3a",
        "800": "#272b2a",
        "900": "#1e2020"
      },
      "blue": {
        "100": "#a4b9cc",
        "200": "#8aa0b4",
        "300": "#778999",
        "400": "#647380",
        "500": "#525d67",
        "600": "#41484f",
        "700": "#33383d",
        "800": "#26292c",
        "900": "#1e1f21"
      },
      "purple": {
        "100": "#c8adc0",
        "200": "#b193a8",
        "300": "#977e90",
        "400": "#7e6a78",
        "500": "#665761",
        "600": "#4e444b",
        "700": "#3c353a",
        "800": "#2b272a",
        "900": "#201f20"
      },
      "accent": {
        "100": "#ec896e",
        "200": "#e05d3a",
        "300": "#be5336",
        "400": "#9e4831",
        "500": "#7e3e2c",
        "600": "#603327",
        "700": "#492b22",
        "800": "#33221d",
        "900": "#241c1a"
      },
      "interactive": "$hue.accent",
      "neutral": "$hue.gray"
    }
  }
}
