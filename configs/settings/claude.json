{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GH_CA_BUNDLE": "~/.claude/cacert.pem",
    "SSL_CERT_FILE": "~/.claude/cacert.pem",
    "NODE_EXTRA_CA_CERTS": "~/.claude/cacert.pem",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "DISABLE_TELEMETRY": "1",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:18080",
    "ANTHROPIC_AUTH_TOKEN": "managed-by-tux",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "Haiku 5.5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Opus 5.5"
  },
  "permissions": {
    "allow": [
      "mcp__context-mode",
      "mcp__context7",
      "mcp__github",
      "mcp__maestro-mcp",
      "mcp__palantir-mcp",
      "mcp__tavily",
      "WebFetch",
      "WebSearch",
      "Read",
      "Edit",
      "Create",
      "Write",
      "Grep",
      "Glob",
      "LS",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(gh:*)",
      "Bash(uv:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(trash:*)",
      "Bash(committer:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(metronome:*)",
      "Bash(basename:*)",
      "Bash(xxd:*)",
      "Bash(grep:*)",
      "Bash(obsidian:*)",
      "Bash(oe:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(gh repo delete:*)",
      "Bash(sudo:*)",
      "Bash(cat *.env*)",
      "Bash(cat *.env.*)",
      "Bash(cat */.env*)",
      "Bash(cat */.env.*)",
      "Bash(cat ~/.zshrc_secrets:*)"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context-mode@context-mode": true
  },
  "additionalDirectories": ["/tmp", "~/Vaults", "~/.agent-browser", "~/.agents", "/var/folders", "~/Downloads", "~/.config/oe"],
  "alwaysThinkingEnabled": true,
  "cleanupPeriodDays": 365,
  "teammateMode": "auto",
  "prefersReducedMotion": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["gh"]
  },
  "hooks": {
    "SessionStart": [
      {
        "_managed": "metronome",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Repos/zacczakk/metronome/configs/hooks/vault-context-loader.js\" IDENTITY.md"
          },
          {
            "type": "command",
            "command": "node \"$HOME/Repos/zacczakk/metronome/configs/hooks/vault-context-loader.js\" SOUL.md"
          },
          {
            "type": "command",
            "command": "node \"$HOME/Repos/zacczakk/metronome/configs/hooks/vault-context-loader.js\" USER.md"
          },
          {
            "type": "command",
            "command": "node \"$HOME/Repos/zacczakk/metronome/configs/hooks/vault-context-loader.js\" STYLE.md"
          },
          {
            "type": "command",
            "command": "node \"$HOME/Repos/zacczakk/metronome/configs/hooks/vault-context-loader.js\" MEMORY.md"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_managed": "metronome",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Repos/zacczakk/metronome/configs/hooks/autoformat-claude.js\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "_managed": "metronome",
        "matcher": "idle_prompt|auth_success",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Repos/zacczakk/metronome/configs/hooks/notify-claude.js\"",
            "async": true
          }
        ]
      }
    ]
  }
}
