    },
    {
      "action": "read",
      "resource": "~/.config/opencode/agents/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode/commands/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.agents/**",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/Downloads/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.config/oe/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/Repos/**",
      "effect": "deny"
    }
  ],
