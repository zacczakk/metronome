{
  "description": "Palantir Foundry data access MCP server via Tux launcher",
  "transport": "stdio",
  "command": "tux",
  "args": [
    "palantir-mcp",
    "start"
  ],
  "enabled": false,
  "external_for": ["claude-code", "opencode"],
  "target_options": {
    "pi": {
      "enabled": true,
      "exposure": "direct",
      "timeout": 20
    }
  }
}
