{
  "$schema": "Skill upstream registry. Consumed by scripts/sync-upstream-skills.ts",
  "skillsDir": "configs/skills",
  "summaryDir": "~/Vaults/Memory/system",
  "upstreams": {
    "anthropics": {
      "repo": "https://github.com/anthropics/skills.git",
      "basePath": "skills",
      "skills": {
        "docx": { "sync": "auto" },
        "frontend-design": { "sync": "auto" },
        "pdf": { "sync": "auto" },
        "pptx": { "sync": "auto" },
        "xlsx": { "sync": "auto" }
      }
    },
    "kepano": {
      "repo": "https://github.com/kepano/obsidian-skills.git",
      "basePath": "skills",
      "skills": {
        "obsidian-cli": { "sync": "manual", "note": "Locally guarded: the executable launches the Electron app; never use for routine retrieval" },
        "defuddle": { "localName": "obsidian-defuddle", "sync": "auto" },
        "obsidian-markdown": { "sync": "auto" },
        "json-canvas": { "localName": "obsidian-json-canvas", "sync": "auto" },
        "obsidian-bases": { "sync": "auto" }
      }
    },
    "cursor": {
      "repo": "https://github.com/cursor/plugins.git",
      "basePath": "cursor-team-kit/skills",
      "skills": {
        "thermo-nuclear-code-quality-review": { "sync": "manual" }
      }
    },
    "obra": {
      "repo": "https://github.com/obra/superpowers.git",
      "basePath": "skills",
      "skills": {
        "writing-plans": { "sync": "manual" }
      }
    },
    "mattpocock": {
      "repo": "https://github.com/mattpocock/skills.git",
      "basePath": "skills/engineering",
      "skills": {
        "diagnosing-bugs": { "sync": "auto" },
        "tdd": { "sync": "auto" }
      }
    },
    "kitlangton-psychopomp": {
      "repo": "https://github.com/kitlangton/psychopomp.git",
      "basePath": ".agents/skills",
      "skills": {
        "psychopomp": { "sync": "manual", "note": "Imported from 3a50a2bf1897ddeaa4e5a71df85224107aaf734b; local checkout and paid-generation guards" },
        "explainer-motion": { "sync": "manual", "note": "Required companion; imported from 3a50a2bf1897ddeaa4e5a71df85224107aaf734b" }
      }
    },
    "ponytail": {
      "repo": "https://github.com/DietrichGebert/ponytail.git",
      "basePath": "skills",
      "skills": {
        "ponytail": { "sync": "auto" },
        "ponytail-review": { "sync": "auto" },
        "ponytail-audit": { "sync": "auto" },
        "ponytail-debt": { "sync": "auto" },
        "ponytail-gain": { "sync": "auto" },
        "ponytail-help": { "sync": "auto" }
      }
    }
  }
}
