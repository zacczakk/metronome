{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/Vaults/Memory/SOUL.md",
    "~/Vaults/Memory/IDENTITY.md",
    "~/Vaults/Memory/USER.md",
    "~/Vaults/Memory/MEMORY.md"
  ],
  "model": "tux/gpt-6-luna",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.env.*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat */.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat */.env.*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat */.env.example",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat ~/.zshrc_secrets",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat ~/.zsh_secrets",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rg * ~/.zsh_secrets",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rg * ~/.zshrc_secrets",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "committer *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Vaults/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Vaults/Memory/system/grooming-reports/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Repos/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/agents/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/get-shit-done/templates/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.mcporter/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agent-browser/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/oe/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Downloads/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.zshrc_secrets",
      "effect": "deny"
